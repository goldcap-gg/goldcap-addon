package-as: GoldCap
enable-nolib-creation: no
# NOTE on topdir: BigWigsMods/packager requires -t <topdir> to itself be a
# git checkout root (it checks for "<topdir>/.git"). Since GoldCap.toc lives
# two levels down (addon/GoldCap/GoldCap.toc) inside this monorepo, topdir
# must be the repo root ("-t . -m addon/.pkgmeta" in the workflow), and
# move-folders below pulls the real addon content up to the package root.
# All paths in "ignore" are relative to topdir (the repo root), not to this
# file's own directory.
# manual-changelog points at the addon/CHANGELOG.md SYMLINK (-> GoldCap/
# CHANGELOG.md) rather than the real file, and that symlink is also in the
# ignore list. Reason: packager resolves the changelog path once, BEFORE
# move-folders runs. If it resolves to the copy inside the package dir
# (anything under addon/GoldCap/), move-folders relocates that copy and the
# recorded path dangles — the GitHub/CurseForge/Wago release-body reads then
# fail on real tagged releases. Ignoring the symlink forces packager to fall
# back to the source-tree path (relative to topdir), which survives. The real
# file still ships inside the zip as GoldCap/CHANGELOG.md via move-folders.
manual-changelog:
  filename: addon/CHANGELOG.md
  markup-type: markdown
ignore:
  - addon/CHANGELOG.md
  - addon/README.md
  - addon/spec
  - addon/.busted
  - addon/.luacheckrc
  - addon/.pkgmeta
  - addon/.release
  - .dockerignore
  - .env.production.example
  - .github
  - .gitignore
  - .nvmrc
  - AGENTS.md
  - apps
  - bruno
  - Caddyfile
  - CLAUDE.md
  - DEPLOY.md
  - DESIGN_BRIEF.md
  - docker-compose.dev.yml
  - docker-compose.yml
  - docs
  - Makefile
  - package.json
  - packages
  - pnpm-lock.yaml
  - pnpm-workspace.yaml
  - README.md
  - scripts
  - tsconfig.base.json
  - UX_AUDIT.md
move-folders:
  GoldCap/addon/GoldCap: GoldCap
