package-as: GoldCap
enable-nolib-creation: no
# NOTE on topdir: BigWigsMods/packager requires -t <topdir> to itself be a git
# checkout root (it checks for "<topdir>/.git"). GoldCap.toc lives one level
# down (GoldCap/GoldCap.toc), so topdir is the repo root ("-t . -m .pkgmeta" in
# the workflow) and move-folders below pulls the real addon content up to the
# package root. All paths in "ignore" are relative to topdir, not to this
# file's own directory.
# manual-changelog points at the CHANGELOG.md SYMLINK (-> GoldCap/CHANGELOG.md)
# rather than the real file, and that symlink is also in the ignore list.
# Reason: packager resolves the changelog path once, BEFORE move-folders runs.
# If it resolves to the copy inside the package dir (anything under GoldCap/),
# move-folders relocates that copy and the recorded path dangles — the
# GitHub/CurseForge/Wago release-body reads then fail on real tagged releases.
# Ignoring the symlink forces packager to fall back to the source-tree path
# (relative to topdir), which survives. The real file still ships inside the
# zip as GoldCap/CHANGELOG.md via move-folders.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
ignore:
  - CHANGELOG.md
  - LICENSE
  - README.md
  - spec
  - .busted
  - .github
  - .luacheckrc
  - .pkgmeta
  - .release
move-folders:
  GoldCap/GoldCap: GoldCap
